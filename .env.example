# Anthropic API key - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# France Travail API credentials - register at https://francetravail.io
# (Catalogue > Offres d'emploi v2 > subscribe your app to get these)
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# Optional overrides — sane defaults are used if you leave these unset
# JOB_AGENT_MODEL=claude-sonnet-5
# JOB_AGENT_TIMEOUT=15
# JOB_AGENT_MAX_RETRIES=3
